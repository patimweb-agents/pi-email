{
  "name": "@patimweb/pi-email",
  "version": "2.1.1",
  "description": "IMAP/SMTP email client extension for pi coding agent. Read, search, send, move, and delete emails from your inbox.",
  "keywords": [
    "pi-package",
    "email",
    "imap",
    "smtp",
    "pi-extension"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patimweb-agents/pi-email.git"
  },
  "bugs": {
    "url": "https://github.com/patimweb-agents/pi-email/issues"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
    "test": "node --experimental-test-module-mocks --experimental-test-coverage --test 'tests/**/*.test.ts'",
    "test:watch": "node --experimental-test-module-mocks --test --watch 'tests/**/*.test.ts'",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "imap": "^0.8.19",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "overrides": {
    "utf7": {
      "semver": "5.7.2"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@semantic-release/git": "^11.0.1",
    "@types/imap": "^0.8.43",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.5.1",
    "semantic-release": "^25.0.9",
    "typebox": "^1.3.27",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Smotherer007/pi-email/main/screenshot.png"
  }
}
